# Include INSIDE the existing authenticated claude-mem-admin server only.
# Never install this snippet in the public machine/ingest virtual host.
location ^~ /organizer/ {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://127.0.0.1:38179;
    proxy_set_header Host 127.0.0.1:38179;
    proxy_set_header Authorization "";
    add_header Cache-Control "private, no-store" always;
}
location ~ ^/api/(projects|observations|summaries|prompts|sessions)$ {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://127.0.0.1:38179;
    proxy_set_header Host 127.0.0.1:38179;
    proxy_set_header Authorization "";
    add_header Cache-Control "private, no-store" always;
}
# The existing location / can additionally inject the navigation link:
# proxy_set_header Accept-Encoding "";
# sub_filter_once on;
# sub_filter '</body>' '<script defer src="/organizer/nav.js"></script></body>';

# Enrich only the authenticated read surfaces; mutations remain on the original
# loopback-only Worker and are not opened by this integration.
location = /api/work-view {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://127.0.0.1:38179;
    proxy_set_header Authorization "";
    add_header Cache-Control "private, no-store" always;
}
location = /api/work-view/events {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    proxy_pass http://127.0.0.1:38179;
    proxy_set_header Authorization "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 3600s;
    add_header Cache-Control "private, no-store" always;
}

server {
    listen 127.0.0.1:37778;
    server_name claude-mem-admin.414222.xyz;

    auth_basic "claude-mem admin";
    auth_basic_user_file /etc/nginx/.claude-mem-admin.htpasswd;
    client_max_body_size 5m;

    # My Work v14 deliberately accepts only loopback Host and no Forwarded
    # headers. This explicitly scoped, authenticated GET-only reverse proxy
    # allows the operator to inspect work remotely WITHOUT exposing the
    # local-only review mutation API or modifying the upstream Worker.
    # Basic Auth is inherited from the enclosing admin virtual host.
    location ^~ /api/work-view {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://127.0.0.1:37777;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:37777;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        add_header Cache-Control "private, no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:37777;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

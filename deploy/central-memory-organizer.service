[Unit]
Description=Read-only categorized Claude-mem catalogue
After=network.target claude-mem.service
RequiresMountsFor=/srv/storage/shared
[Service]
Type=simple
WorkingDirectory=/root/apps/central-memory-bridges/memory-organizer
Environment=CLAUDE_MEM_DATA_DIR=/srv/storage/shared/us-migrated/claude-mem
Environment=MEMORY_ORGANIZER_STATE=/srv/storage/shared/us-migrated/claude-mem/organizer
ExecStart=/usr/bin/python3 /root/apps/central-memory-bridges/memory-organizer/organizer.py serve --port 38179
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/storage/shared/us-migrated/claude-mem/organizer
MemoryMax=256M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
